---
import { t } from "../../utils/i18n";
import { GetEducationUseCase } from "./application/getEducation.usecase";
import { staticEducationRepository } from "./infrastructure/StaticEducationRepository";

const lang = "en";
const getEducationUseCase = new GetEducationUseCase(staticEducationRepository);
const { university: universityItem, certifications: certificationItems, languages } = await getEducationUseCase.execute(lang);
---

<section class="scroll-m-20 py-20 px-8 max-md:py-14" id="education" aria-label="Formación académica y certificaciones">
  <div class="mx-auto max-w-5xl">
    <div class="text-center mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-accent-100 text-accent-800 dark:bg-accent-950/50 dark:text-accent-300 mb-3">
        {lang === "en" ? "Official CV" : "CV Oficial"}
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white">
        <span data-i18n="education.title">{t("education.title", lang)}</span>{" "}
        <span class="text-accent-600 dark:text-accent-400" data-i18n="education.titleGradient">{t("education.titleGradient", lang)}</span>
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mt-3 max-w-2xl mx-auto text-base" data-i18n="education.subtitle">
        {t("education.subtitle", lang)}
      </p>
    </div>

    <!-- Carrera Universitaria Destacada -->
    <div class="mb-12">
      <div class="p-8 max-md:p-6 rounded-3xl bg-linear-to-br from-accent-50/80 via-white to-gray-50 dark:from-accent-950/20 dark:via-gray-900 dark:to-gray-950 border-2 border-accent-200 dark:border-accent-800/60 shadow-lg shadow-accent-500/5 glass-panel reveal">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex items-center gap-3">
            <span class="p-3 rounded-2xl bg-accent-600 text-white dark:bg-accent-500 shadow-md">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
              </svg>
            </span>
            <div>
              <span class="px-2.5 py-0.5 text-xs font-bold rounded-full bg-accent-200/80 text-accent-900 dark:bg-accent-900/60 dark:text-accent-200">
                {lang === "en" ? "Higher Education • In Progress" : "Educación Superior • En Curso"}
              </span>
              <h3 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white mt-1">
                {universityItem.title}
              </h3>
            </div>
          </div>
          <span class="text-sm font-semibold text-accent-700 dark:text-accent-400 px-3 py-1 bg-white/80 dark:bg-gray-800/80 rounded-xl border border-accent-200/60 dark:border-accent-700/40">
            {universityItem.period}
          </span>
        </div>
        <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mt-2">
          {universityItem.institution}
        </p>
        <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 mt-4 leading-relaxed">
          {universityItem.desc}
        </p>
      </div>
    </div>

    <!-- Grilla de Certificaciones Técnicas en el Orden del CV -->
    <div class="mb-14">
      <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
        <svg class="size-5 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
        </svg>
        {lang === "en" ? "Specialized Certifications & Courses" : "Certificaciones y Cursos Especializados"}
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          certificationItems.map((item, idx) => (
            <div class={`p-6 rounded-2xl bg-white/70 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 shadow-xs hover:border-accent-400/50 dark:hover:border-accent-500/50 transition-all duration-300 glass-panel reveal reveal-delay-${(idx % 3) + 1}`}>
              <div class="flex items-start justify-between gap-3 mb-2">
                <span class="px-2.5 py-0.5 text-xs font-semibold rounded-md bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
                  {item.institution}
                </span>
                <span class="text-xs font-mono text-gray-500 dark:text-gray-400">
                  {item.period}
                </span>
              </div>
              <h4 class="text-base font-bold text-gray-900 dark:text-white leading-snug">
                {item.title}
              </h4>
              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-2 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Sección de Idiomas del CV -->
    <div class="p-8 max-md:p-6 rounded-3xl bg-white/70 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 shadow-sm glass-panel reveal">
      <div class="flex items-center gap-3 mb-6">
        <span class="p-2.5 rounded-xl bg-blue-600 text-white dark:bg-blue-500 shadow-md">
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/>
          </svg>
        </span>
        <div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">
            {lang === "en" ? "Languages" : "Idiomas"}
          </h3>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            {lang === "en" ? "Global communication profile based on CV" : "Perfil de comunicación global según CV"}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          languages.map((langItem) => (
            <div class="p-6 rounded-2xl bg-white/80 dark:bg-gray-950/70 border border-gray-200 dark:border-gray-800/90 shadow-xs hover:border-accent-400/40 dark:hover:border-accent-500/40 transition-all">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-base font-bold text-gray-900 dark:text-white">
                  {langItem.name}
                </span>
                <span class={`px-2.5 py-0.5 text-xs font-bold rounded-full ${langItem.badge}`}>
                  {langItem.level}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                {langItem.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
