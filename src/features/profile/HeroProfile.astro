---
import Button from "../../core/ui/Button.astro";
import { t } from "../../utils/i18n";
import { GetProfileUseCase } from "./application/getProfile.usecase";
import { staticProfileRepository } from "./infrastructure/StaticProfileRepository";

const lang = "en";
const getProfileUseCase = new GetProfileUseCase(staticProfileRepository);
const profile = await getProfileUseCase.execute(lang);
---

<section class="scroll-m-20 px-8 max-sm:px-4 py-16 max-md:py-12" id="home" aria-label="Professional Profile and Hero">
  <div class="mx-auto max-w-7xl">
    <div class="rounded-3xl bg-white/70 dark:bg-gray-900/60 border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden glass-panel">
      <!-- Fila Principal de Presentación -->
      <div class="grid grid-cols-1 lg:grid-cols-12 items-center gap-8 lg:gap-12 p-8 sm:p-12">
        <div class="lg:col-span-5 flex items-center justify-center reveal">
          <div class="relative size-64 sm:size-72 md:size-80 lg:size-[340px] rounded-full p-2.5 bg-gradient-to-tr from-accent-500/25 via-accent-500/10 to-transparent dark:from-accent-400/20 dark:via-accent-400/5 shadow-2xl shadow-accent-500/10 border border-accent-200/50 dark:border-accent-700/30 group">
            <div class="size-full rounded-full overflow-hidden bg-white dark:bg-gray-800 ring-4 ring-white dark:ring-gray-900 shadow-inner">
              <a
                href="https://github.com/DavidSolorza"
                class="block size-full rounded-full bg-center bg-cover transition-transform duration-500 group-hover:scale-105"
                style={`background-image: url(${profile.avatarUrl})`}
                aria-label={t("hero.aboutMe", lang)}
              />
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 reveal reveal-delay-1">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300">
              <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span data-i18n="hero.available">{t("hero.available", lang)}</span>
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300">
              📍 {profile.contact.location}
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 dark:bg-blue-950/60 text-blue-800 dark:text-blue-300">
              🌐 {lang === "en" ? "Bilingual (English B1)" : "Bilingüe (Inglés B1)"}
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white mb-2 max-md:text-3xl tracking-tight notranslate" translate="no">
            {profile.name}
            <span class="sr-only"> - Full-Stack & Mobile Developer (Bilingual) | Software Engineer</span>
          </h1>

          <p class="text-xl sm:text-2xl font-bold text-accent-600 dark:text-accent-400 mb-4" data-i18n="hero.profileTitle">
            {profile.title}
          </p>

          <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-6 font-normal">
            <span data-i18n="hero.tagline">{profile.tagline}</span>
          </p>

          <!-- Contacto Rápido Directo -->
          <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-gray-500 dark:text-gray-400 mb-8 pt-4 border-t border-gray-100 dark:border-gray-800">
            <a href={`tel:${profile.contact.phone.replace(/\s+/g, '')}`} class="flex items-center gap-1.5 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              <span>{profile.contact.phone}</span>
            </a>
            <span>•</span>
            <a href={`mailto:${profile.contact.email}`} class="flex items-center gap-1.5 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>{profile.contact.email}</span>
            </a>
          </div>

          <div class="flex flex-wrap gap-3">
            <Button link="/#projects" text={t("hero.viewProjects", lang)} textI18n="hero.viewProjects" iconName="code" variant="dark" />
            <Button link="/#contact" text={t("hero.contactMe", lang)} textI18n="hero.contactMe" iconName="envelope" variant="default" />
            <Button
              link={profile.contact.resumeUrl}
              text={t("hero.downloadCV", lang)}
              textI18n="hero.downloadCV"
              iconName="rocket"
              variant="default"
              isExternal={true}
            />
          </div>
        </div>
      </div>

      <!-- Fila de Conocimientos y Aptitudes del CV -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-200/50 dark:bg-gray-800/50 border-t border-gray-200 dark:border-gray-800">
        <!-- 1. Conocimientos Técnicos -->
        <div class="bg-white/60 dark:bg-gray-900/50 p-8 max-md:p-6 reveal reveal-delay-2">
          <div class="flex items-center gap-2 mb-4">
            <span class="p-1.5 rounded-lg bg-accent-100 dark:bg-accent-950/80 text-accent-700 dark:text-accent-300">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </span>
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-800 dark:text-gray-200" data-i18n="hero.techTitle">
              {t("hero.techTitle", lang)}
            </h3>
          </div>
          <div class="flex flex-wrap gap-1.5 max-h-48 overflow-y-auto pr-1">
            {
              profile.techStack.map((tech) => (
                <span class="px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 rounded-md border border-gray-200/70 dark:border-gray-700/60">
                  {tech.name}
                </span>
              ))
            }
          </div>
        </div>

        <!-- 2. Aptitudes Profesionales del CV -->
        <div class="bg-white/60 dark:bg-gray-900/50 p-8 max-md:p-6 reveal reveal-delay-3 border-t md:border-t-0 md:border-l border-gray-200 dark:border-gray-800">
          <div class="flex items-center gap-2 mb-4">
            <span class="p-1.5 rounded-lg bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300">
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </span>
            <h3 class="text-sm font-bold uppercase tracking-wider text-gray-800 dark:text-gray-200" data-i18n="hero.aptitudesTitle">
              {t("hero.aptitudesTitle", lang)}
            </h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {
              profile.aptitudes.map((apt) => (
                <span class="px-2.5 py-1 text-xs font-medium text-amber-900 dark:text-amber-200 bg-amber-50 dark:bg-amber-950/40 rounded-md border border-amber-200/60 dark:border-amber-800/40">
                  ✦ {apt}
                </span>
              ))
            }
          </div>
        </div>

        <!-- 3. Redes y Código (GitHub & LinkedIn) -->
        <div class="bg-white/60 dark:bg-gray-900/50 p-8 max-md:p-6 reveal reveal-delay-4 border-t md:border-t-0 md:border-l border-gray-200 dark:border-gray-800 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-4">
              <span class="p-1.5 rounded-lg bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300">
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
              </span>
              <h3 class="text-sm font-bold uppercase tracking-wider text-gray-800 dark:text-gray-200">
                {lang === "en" ? "Professional Networks" : "Redes Profesionales"}
              </h3>
            </div>
            <p class="text-xs text-gray-600 dark:text-gray-400 leading-relaxed mb-4">
              {lang === "en" ? "Explore repositories featuring Clean Architecture, microservices, and production deployments." : "Explora repositorios con implementaciones de Clean Architecture, microservicios y despliegues productivos."}
            </p>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <a
              href={profile.contact.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900 hover:opacity-90 transition-opacity"
            >
              GitHub <span>&rarr;</span>
            </a>
            <a
              href={profile.contact.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg bg-blue-600 text-white hover:bg-blue-700 transition-colors"
            >
              LinkedIn <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
