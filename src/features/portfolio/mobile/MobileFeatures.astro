---
import { t } from "../../../utils/i18n";
import { Icon } from "astro-icon/components";
const { project } = Astro.props;
const { mobileDetails } = project;
const lang = "es"; // Default to es, client script will update
---

<div class="space-y-12">
  <div class="text-center space-y-4">
    <h2 class="text-3xl lg:text-4xl font-bold text-blacktext dark:text-white" data-i18n="projects.featuresTitle">
      Características Principales
    </h2>
    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto" data-i18n="projects.featuresDesc">
      Descubre todo lo que esta aplicación tiene para ofrecer.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {mobileDetails?.features?.map((feature: any) => (
      <div class="bg-white dark:bg-[#0a0a0a] border border-gray-100 dark:border-[#1f1f1f] p-8 rounded-[2rem] relative overflow-hidden group hover:-translate-y-1 transition-all duration-300 shadow-sm hover:shadow-xl dark:shadow-none">
        <!-- Accent Glow (Blurred Orb) -->
        <div class={`absolute -top-16 -right-16 w-56 h-56 bg-gradient-to-br ${mobileDetails.themeColor} opacity-20 dark:opacity-30 rounded-full blur-[40px] transition-transform duration-700 group-hover:scale-125`}></div>
        
        <!-- Icon Container -->
        <div class="mb-6">
          <Icon name={`lucide:${feature.icon}`} class="w-8 h-8 text-gray-800 dark:text-white" stroke-width="2" />
        </div>
        
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-3 tracking-tight" data-i18n={feature.titleI18n}>
          {t(feature.titleI18n, lang)}
        </h3>
        
        <p class="text-gray-500 dark:text-gray-400 leading-relaxed text-sm" data-i18n={feature.descriptionI18n}>
          {t(feature.descriptionI18n, lang)}
        </p>
      </div>
    ))}
  </div>
</div>
