---
import Layout from "../core/layout/Layout.astro";
import HeroProfile from "../features/profile/HeroProfile.astro";
import ExperienceSection from "../features/experience/ExperienceSection.astro";
import ProjectsGrid from "../features/portfolio/ProjectsGrid.astro";
import EducationSection from "../features/education/EducationSection.astro";
import Contact from "../features/contact/Contact.astro";

const pageTitle = "David Solorza | Software Engineer • Mobile & Offline-First Systems | Scalable Backends";
const description = "Official engineering portfolio of David Solorza — Software Engineer specialized in Flutter, Mobile & Offline-First Systems, Scalable Backends (Node.js/Python), and Distributed Microservices.";
const ogimage = {
  url: "/images/imagedefault.webp",
  alt: "Professional engineering portfolio of David Solorza - Software Engineer specialized in Flutter, Offline-First Mobile, Node.js, and Python.",
};
---

<Layout pageTitle={pageTitle} description={description} ogimage={ogimage}>
  <!-- 1. Presentación (Hero, Perfil Profesional, Contacto Rápido y Conocimientos/Aptitudes) -->
  <HeroProfile />

  <!-- 2. Experiencias (Historial Laboral del CV: Wolf Enterprise y Fundación FreeAgents) -->
  <ExperienceSection />

  <!-- 3. Proyectos (Proyectos Destacados del CV y Catálogo de Aplicaciones Web y Mobile) -->
  <ProjectsGrid />

  <!-- 4. Formación (Educación Superior Universidad de Caldas, Certificaciones PUC Chile/SENA e Idiomas) -->
  <EducationSection />

  <!-- 5. Contacto (Canales Directos y Formulario de Mensajes) -->
  <Contact />
</Layout>
