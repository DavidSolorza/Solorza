---
import Layout from "../core/layout/Layout.astro";
import HeroProfile from "../features/profile/HeroProfile.astro";
import ExperienceSection from "../features/profile/ExperienceSection.astro";
import ProjectsGrid from "../features/portfolio/ProjectsGrid.astro";
import Contact from "../features/contact/Contact.astro";

const pageTitle = "David Solorza | Ingeniero de Sistemas & Desarrollador Frontend";
const description = "Portafolio de David Solorza — Ingeniero de Sistemas y desarrollador frontend especializado en aplicaciones web, automatización y proyectos full-stack. Estudiante de ingeniería enfocado en soluciones tecnológicas.";
const ogimage = {
  url: "/images/imagedefault.webp",
  alt: "Screenshot of a web portfolio with a modern and dark design. Featuring David Solorza, a Frontend Developer and Systems Engineer with experience in modern web technologies.",
};
---

<Layout pageTitle={pageTitle} description={description} ogimage={ogimage}>
  <HeroProfile />
  <ExperienceSection />
  <ProjectsGrid />
  <Contact />
</Layout>
