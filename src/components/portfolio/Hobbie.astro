---
import { t } from "../../utils/i18n";
const { tag } = Astro.props;
const lang = "es";
const tagKey = tag.toLowerCase();
---

<span
    class="px-4 py-1 rounded-full text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-blacktext bg-accent-50 dark:bg-gray-800 border border-accent-200 dark:border-gray-700 hover:bg-accent-100 dark:hover:bg-gray-700 cursor-default transition-all ease-in-out duration-300"
    data-i18n={`hobbiesItems.${tagKey}`}
>
{t(`hobbiesItems.${tagKey}`, lang)}
</span>
