---
import { Icon } from "astro-icon/components";
const { project } = Astro.props;
const { mobileDetails } = project;

const phones = mobileDetails?.screenshots?.slice(1) || [];
const tablets = mobileDetails?.tabletScreenshots || [];
---

<div class="space-y-16">
  <div class="text-center space-y-4 px-4">
    <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white" data-i18n="projects.galleryTitle">
      Galería de la Aplicación
    </h2>
    <p class="text-gray-500 dark:text-gray-400 max-w-2xl mx-auto" data-i18n="projects.galleryDesc">
      Diseño responsivo optimizado para cualquier formato de pantalla.
    </p>
  </div>

  <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8 space-y-24">
    
    <!-- Tablets Section (Strict Grid) -->
    {tablets.length > 0 && (
      <div class="space-y-8">
        <h3 class="text-xl font-medium text-gray-400 text-center tracking-widest uppercase text-sm">Versión Tablet</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 md:gap-12 justify-items-center">
          {tablets.map((src: string, index: number) => (
            <div class="lightbox-trigger relative w-full max-w-[480px] bg-black rounded-[1.5rem] border-[12px] border-black overflow-hidden shadow-[0_20px_40px_-10px_rgba(0,0,0,0.6)] group transition-transform duration-500 hover:-translate-y-2 cursor-pointer" data-src={src} data-type="tablet">
              <!-- Tablet Camera -->
              <div class="absolute top-2 left-1/2 -translate-x-1/2 w-2 h-2 bg-gray-800 rounded-full z-30"></div>
              
              <img 
                src={src} 
                alt={`Tablet Screenshot ${index + 1}`} 
                class="w-full h-auto object-cover block"
                onerror="this.style.display='none'"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Info Box (Mixed between sections) -->
    <div class="relative w-full rounded-[2rem] overflow-hidden bg-[#0a0a0a] border border-gray-800 p-8 md:p-12 shadow-[0_20px_40px_-10px_rgba(0,0,0,0.8)] flex flex-col md:flex-row items-center gap-8 md:gap-12 hover:border-gray-700 transition-colors">
      <div class={`absolute -top-32 -right-32 w-80 h-80 bg-gradient-to-br ${mobileDetails.themeColor} opacity-10 blur-[80px] rounded-full pointer-events-none`}></div>
      
      <div class="relative z-10 flex-1 space-y-4 text-center md:text-left">
        <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight">¿Cómo funciona la aplicación?</h3>
        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
          La aplicación cuida tu batería de forma silenciosa y sin consumir energía extra. Mide constantemente factores clave como la temperatura y la salud de tu dispositivo, guardando toda esa información internamente. Esto asegura que tus datos sean 100% privados y que todo funcione a la perfección sin necesidad de usar internet.
        </p>
      </div>
      
      <div class="relative z-10 flex gap-4 w-full md:w-auto justify-center">
        <div class="flex flex-col items-center justify-center bg-black border border-gray-800 rounded-2xl p-4 w-28 h-28 shadow-inner">
           <Icon name="lucide:cpu" class="w-8 h-8 text-gray-300 mb-2" />
           <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider text-center">Bajo<br>Consumo</span>
        </div>
        <div class="flex flex-col items-center justify-center bg-black border border-gray-800 rounded-2xl p-4 w-28 h-28 shadow-inner">
           <Icon name="lucide:shield-check" class="w-8 h-8 text-gray-300 mb-2" />
           <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider text-center">Datos<br>Privados</span>
        </div>
      </div>
    </div>

    <!-- Phones Section (Strict Grid) -->
    {phones.length > 0 && (
      <div class="space-y-8">
        <h3 class="text-xl font-medium text-gray-400 text-center tracking-widest uppercase text-sm">Versión Móvil</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 justify-items-center">
          {phones.map((src: string, index: number) => (
            <div class="lightbox-trigger relative w-full max-w-[280px] bg-black rounded-[2rem] border-[8px] border-black overflow-hidden shadow-[0_20px_40px_-10px_rgba(0,0,0,0.6)] group transition-transform duration-500 hover:-translate-y-2 cursor-pointer" data-src={src} data-type="phone">
              <!-- Phone Notch -->
              <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/3 h-4 bg-black rounded-b-xl z-30"></div>
              
              <img 
                src={src} 
                alt={`Phone Screenshot ${index + 1}`} 
                class="w-full h-auto object-cover block"
                onerror="this.style.display='none'"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Second Info Box (Alerts & UI) -->
    <div class="relative w-full rounded-[2rem] overflow-hidden bg-[#0a0a0a] border border-gray-800 p-8 md:p-12 shadow-[0_20px_40px_-10px_rgba(0,0,0,0.8)] flex flex-col md:flex-row-reverse items-center gap-8 md:gap-12 hover:border-gray-700 transition-colors mt-12">
      <div class={`absolute -bottom-32 -left-32 w-80 h-80 bg-gradient-to-tr ${mobileDetails.themeColor} opacity-10 blur-[80px] rounded-full pointer-events-none`}></div>
      
      <div class="relative z-10 flex-1 space-y-4 text-center md:text-right">
        <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight">Dale años extra de vida a tu dispositivo</h3>
        <p class="text-gray-400 leading-relaxed text-sm md:text-base">
          Olvídate del miedo a arruinar tu batería. La app te avisa en el segundo exacto en que debes conectar o desconectar tu cargador para frenar el desgaste para siempre. Todo envuelto en una interfaz espectacular que cuida tus ojos y exprime hasta la última gota de energía.
        </p>
      </div>
      
      <div class="relative z-10 flex gap-4 w-full md:w-auto justify-center">
        <div class="flex flex-col items-center justify-center bg-black border border-gray-800 rounded-2xl p-4 w-28 h-28 shadow-inner">
           <Icon name="lucide:bell-ring" class="w-8 h-8 text-gray-300 mb-2" />
           <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider text-center">Alertas<br>Activas</span>
        </div>
        <div class="flex flex-col items-center justify-center bg-black border border-gray-800 rounded-2xl p-4 w-28 h-28 shadow-inner">
           <Icon name="lucide:moon" class="w-8 h-8 text-gray-300 mb-2" />
           <span class="text-[10px] text-gray-500 font-bold uppercase tracking-wider text-center">Modo<br>Oscuro</span>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Lightbox Modal -->
<dialog id="gallery-lightbox" class="backdrop:bg-black/90 backdrop:backdrop-blur-sm bg-transparent p-0 w-full h-full max-w-none max-h-none m-0 overflow-hidden">
  <div class="relative w-full h-full flex items-center justify-center p-4 md:p-8" id="lightbox-container">
    <!-- Close button -->
    <button id="lightbox-close" class="absolute top-6 right-6 md:top-10 md:right-10 z-50 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white p-3 rounded-full transition-all hover:scale-110 active:scale-95">
      <Icon name="lucide:x" class="w-6 h-6" />
    </button>
    
    <!-- Dynamic Device Frame -->
    <div id="lightbox-frame" class="relative bg-black overflow-hidden shadow-[0_0_80px_rgba(0,0,0,1)] transition-all duration-300 transform scale-95 opacity-0">
      <img id="lightbox-img" src="" alt="Enlarged screenshot" class="w-full h-full object-cover block" />
    </div>
  </div>
</dialog>

<script>
  const triggers = document.querySelectorAll('.lightbox-trigger');
  const dialog = document.getElementById('gallery-lightbox') as HTMLDialogElement;
  const closeBtn = document.getElementById('lightbox-close');
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const frame = document.getElementById('lightbox-frame');
  const container = document.getElementById('lightbox-container');

  if (dialog && img && frame) {
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-src');
        const type = trigger.getAttribute('data-type');
        
        if (src) img.src = src;
        
        // Configure Frame Classes based on device type to mimic physical devices
        if (type === 'phone') {
          frame.className = "relative bg-black overflow-hidden shadow-2xl transition-all duration-300 rounded-[3rem] border-[16px] border-black max-w-[400px] w-full aspect-[1/2.1] scale-100 opacity-100";
        } else {
          frame.className = "relative bg-black overflow-hidden shadow-2xl transition-all duration-300 rounded-[2rem] border-[20px] border-black max-w-[1000px] w-full aspect-[1.5/1] scale-100 opacity-100";
        }
        
        dialog.showModal();
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
      });
    });

    const closeModal = () => {
      // Trigger out-animation
      frame.classList.remove('scale-100', 'opacity-100');
      frame.classList.add('scale-95', 'opacity-0');
      
      setTimeout(() => {
        dialog.close();
        document.body.style.overflow = '';
        img.src = '';
      }, 300);
    };

    closeBtn?.addEventListener('click', closeModal);
    
    // Close on background click
    container?.addEventListener('click', (e) => {
      if (e.target === container) closeModal();
    });
    
    // Close on Escape key
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });
  }
</script>
