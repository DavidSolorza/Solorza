---
const { project } = Astro.props;
const { mobileDetails } = project;
---

<div class="space-y-12">
  <div class="text-center space-y-4">
    <h2 class="text-3xl lg:text-4xl font-bold text-blacktext dark:text-white" data-i18n="projects.galleryTitle">
      Galería de la Aplicación
    </h2>
    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto" data-i18n="projects.galleryDesc">
      Un vistazo a la interfaz y experiencia de usuario.
    </p>
  </div>

  <div class="flex overflow-x-auto gap-6 pb-8 snap-x snap-mandatory scrollbar-hide py-4 px-4 -mx-4">
    {mobileDetails?.screenshots?.map((screenshot: string, index: number) => (
      <div class="snap-center shrink-0 w-[260px] h-[540px] relative rounded-[2.5rem] bg-gray-950 shadow-xl border-[6px] border-gray-800 overflow-hidden group">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-gray-800 rounded-b-2xl z-30"></div>
        
        <!-- Placeholder content if image fails -->
        <div class={`absolute inset-0 bg-gradient-to-br ${mobileDetails.themeColor} opacity-50 flex items-center justify-center text-white/50 text-sm`}>
          Mockup {index + 1}
        </div>
        
        <!-- Real Image -->
        <img 
          src={screenshot} 
          alt={`Screenshot ${index + 1}`} 
          class="absolute inset-0 w-full h-full object-cover z-10 transition-transform duration-700 group-hover:scale-105"
          onerror="this.style.display='none'"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
