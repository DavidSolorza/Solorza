---
import { t } from "../../../utils/i18n";
import { Icon } from "astro-icon/components";
const { project } = Astro.props;
const { mobileDetails } = project;
const lang = "es"; // Default to es, client script will update
---

<div class="space-y-12">
  <div class="text-center space-y-4">
    <h2 class="text-3xl lg:text-4xl font-bold text-blacktext dark:text-white" data-i18n="projects.featuresTitle">
      Características Principales
    </h2>
    <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto" data-i18n="projects.featuresDesc">
      Descubre todo lo que esta aplicación tiene para ofrecer.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {mobileDetails?.features?.map((feature: any) => (
      <div class="glass-panel p-8 rounded-3xl relative overflow-hidden group hover:-translate-y-2 transition-all duration-300">
        <!-- Accent Glow -->
        <div class={`absolute top-0 right-0 w-32 h-32 bg-gradient-to-br ${mobileDetails.themeColor} opacity-10 rounded-bl-full transition-transform group-hover:scale-150`}></div>
        
        <div class={`inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-gradient-to-br ${mobileDetails.themeColor} text-white mb-6 shadow-lg`}>
          <Icon name={`lucide:${feature.icon}`} class="w-7 h-7" />
        </div>
        
        <h3 class="text-xl font-bold text-blacktext dark:text-white mb-3" data-i18n={feature.titleI18n}>
          {t(feature.titleI18n, lang)}
        </h3>
        
        <p class="text-gray-600 dark:text-gray-400 leading-relaxed" data-i18n={feature.descriptionI18n}>
          {t(feature.descriptionI18n, lang)}
        </p>
      </div>
    ))}
  </div>
</div>
